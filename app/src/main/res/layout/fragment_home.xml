<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- Accesos rápidos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:text="Accesos rápidos"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:letterSpacing="0.05" />

        <GridLayout
            android:id="@+id/gridShortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="false"
            android:alignmentMode="alignBounds">

            <!-- Filled dynamically -->

        </GridLayout>

        <!-- Favoritos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Favoritos"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvFavEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toca ★ en un código"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- Recientes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Recientes"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:letterSpacing="0.05" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/tvRecentsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aún no has marcado códigos"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
